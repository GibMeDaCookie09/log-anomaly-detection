[Unit]
Description=Run the anomaly detector over the service's own logs
# Nothing to read if Docker is not up.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
ExecStart=/opt/loganomaly/run_self_monitor.sh
# Output goes to the journal; the awslogs driver only covers containers.
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
