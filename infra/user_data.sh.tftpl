#!/usr/bin/env bash
# Bootstrap for the ${project_name} host.
#
# This installs the *mechanism* only - Docker, directories, and the environment
# the deploy needs. It deliberately does not contain the deploy logic: that lives
# in deploy/deploy.sh in the repo and is copied over on every deploy, so it is
# versioned with the code rather than baked into an instance that would have to
# be replaced to change it.
#
# Output lands in /var/log/cloud-init-output.log.
set -euxo pipefail

dnf update -y
dnf install -y docker

systemctl enable --now docker
usermod -aG docker ec2-user

# AL2023 ships AWS CLI v2, but guard rather than assume.
command -v aws >/dev/null 2>&1 || dnf install -y awscli-2

# Compose v2, for the Grafana stack in monitoring/. Packaged on AL2023 under
# a couple of names depending on release, so try the repo first and fall back
# to the upstream plugin binary rather than guessing.
if ! docker compose version >/dev/null 2>&1; then
  dnf install -y docker-compose-plugin 2>/dev/null || {
    install -d /usr/local/lib/docker/cli-plugins
    curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \n      -o /usr/local/lib/docker/cli-plugins/docker-compose
    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
  }
fi

# Fixed paths, deliberately not derived from project_name: the deploy and
# monitoring scripts default to these, and deriving them from a Terraform
# variable meant renaming the project silently broke all of them.
install -d -m 0755 /etc/loganomaly /opt/loganomaly /var/log/loganomaly
chown ec2-user:ec2-user /opt/loganomaly /var/log/loganomaly

# Everything the deploy script needs to know, resolved by Terraform at apply time
# so the script itself carries no hardcoded account or region details.
cat > /etc/loganomaly/env <<'ENVEOF'
AWS_REGION=${aws_region}
LOG_GROUP=${log_group}
S3_BUCKET=${s3_bucket}
API_PORT=${api_port}
CONTAINER_NAME=${project_name}
METRIC_NAMESPACE=${metric_namespace}
ENVEOF
chmod 0644 /etc/loganomaly/env

# IMDSv2 is enforced on this instance, so the token exchange is mandatory - a
# plain GET against the metadata endpoint returns 401.
TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $${TOKEN}" \
  http://169.254.169.254/latest/meta-data/instance-id)
echo "INSTANCE_ID=$${INSTANCE_ID}" >> /etc/loganomaly/env

# Optional first-boot container. Normally empty: the first real image comes from
# a release tag, and the CD workflow puts it here. This exists so `terraform
# apply` alone can stand up something reachable when demonstrating the infra.
IMAGE="${container_image}"
if [ -n "$${IMAGE}" ]; then
  docker pull "$${IMAGE}"
  docker run -d \
    --name ${project_name} \
    --restart unless-stopped \
    -p ${api_port}:8000 \
    --log-driver=awslogs \
    --log-opt awslogs-region=${aws_region} \
    --log-opt awslogs-group=${log_group} \
    --log-opt awslogs-stream="app/$${INSTANCE_ID}" \
    "$${IMAGE}"
fi

echo "bootstrap complete"
