# Copy to monitoring/.env on the instance. It is gitignored.
#
#   cp monitoring/.env.example monitoring/.env

# No default is provided for the password on purpose: the compose file fails to
# start without it rather than publishing a console with known credentials.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-before-starting

# Must match the region the metrics are in.
AWS_REGION=ap-south-1
